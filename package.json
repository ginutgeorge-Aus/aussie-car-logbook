{
  "name": "ginoos-log-book",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "knip": "knip",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file src/db/seed.sql",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler d1 migrations apply DB --remote && opennextjs-cloudflare deploy",
    "gen:wrangler": "node scripts/gen-wrangler.mjs",
    "ci:build": "node scripts/gen-wrangler.mjs && opennextjs-cloudflare build",
    "ci:deploy": "wrangler d1 migrations apply DB --remote && OPEN_NEXT_DEPLOY=true wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "knip": "^6.39.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.0",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
